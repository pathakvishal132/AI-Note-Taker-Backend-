# Django Settings
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (sqlite or postgresql)
DB_ENGINE=sqlite
# PostgreSQL settings (only used when DB_ENGINE=postgresql)
# DB_NAME=notetaker
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# STT (Speech-to-Text) Configuration
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# LLM Configuration
# Supported providers: gemini, openai, openai_compatible, mock
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.0-flash
# For OpenAI: LLM_PROVIDER=openai, LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL is only needed for openai_compatible providers
LLM_BASE_URL=
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# File Upload
MAX_UPLOAD_SIZE_MB=25

# API Settings
API_PAGE_SIZE=20
API_THROTTLE_RATE=10/hour
VOICE_THROTTLE_RATE=10/hour

# Timezone for date interpretation
APP_TIMEZONE=UTC

# Logging
DJANGO_LOG_LEVEL=INFO

# Production Security (set these in production)
# SECURE_SSL_REDIRECT=True
